{
  "name": "rye",
  "productName": "Rye",
  "version": "0.1.0",
  "private": true,
  "description": "AI notepad for therapy sessions, for macOS and Windows",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "postinstall": "install-electron",
    "dist:mac": "electron-vite build && electron-builder --mac --arm64 --config electron-builder.mac-arm64.yml && codesign --force --deep --sign - ../../dist/rye/mac-arm64/Rye.app",
    "dist:mac-x64": "electron-vite build && electron-builder --mac --x64 --config electron-builder.mac-x64.yml && codesign --force --deep --sign - ../../dist/rye/mac/Rye.app",
    "dist:win": "electron-vite build && electron-builder --win --config electron-builder.yml"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@fugood/whisper.node": "1.1.3",
    "@huggingface/tokenizers": "^0.2.0",
    "@tiptap/extension-mention": "^3.32.0",
    "@tiptap/suggestion": "^3.32.0",
    "better-sqlite3-multiple-ciphers": "13.0.3",
    "electron-updater": "^6.8.11",
    "onnxruntime-node": "^1.31.1",
    "openai": "^7.43.0",
    "sherpa-onnx-node": "1.13.8"
  },
  "devDependencies": {
    "electron": "45.0.0"
  }
}
