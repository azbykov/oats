# Rye's build settings. Copy to .env in this folder; values are built into the app by
# electron-vite. Rye does not read the .env at the repository root: that one is Oats's.
# The settings and what they mean are the same as in ../../.env.example.

# Sign-in with Google / Yandex (Settings → Accounts): either through a site that holds the
# OAuth clients, which must send the browser back to rye://signed-in ...
# MAIN_VITE_AUTH_URL=

# ... or the app's own clients, talking to Google and Yandex directly.
MAIN_VITE_GOOGLE_CLIENT_ID=
MAIN_VITE_GOOGLE_CLIENT_SECRET=
MAIN_VITE_YANDEX_CLIENT_ID=
MAIN_VITE_YANDEX_CLIENT_SECRET=

# Loopback port for the sign-in redirect. Oats uses 47821 by default; give Rye another one
# if both may be signing in at the same moment (with a direct Yandex client, its Redirect
# URI has to name the same port).
# MAIN_VITE_OAUTH_PORT=47822

# Where Rye looks for new releases. Unset: no update checks. Never Oats's address: Rye
# would offer Oats's builds as its own updates.
# MAIN_VITE_UPDATE_URL=
