{
  "name": "oats",
  "productName": "Oats",
  "version": "0.6.1",
  "private": true,
  "description": "AI meeting notepad for macOS and Windows",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "postinstall": "install-electron",
    "dist:mac": "electron-vite build && electron-builder --mac --arm64 --config electron-builder.mac-arm64.yml && codesign --force --deep --sign - ../../dist/mac-arm64/Oats.app",
    "dist:mac-x64": "electron-vite build && electron-builder --mac --x64 --config electron-builder.mac-x64.yml && codesign --force --deep --sign - ../../dist/mac/Oats.app",
    "dist:win": "electron-vite build && electron-builder --win --config electron-builder.yml"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@fugood/whisper.node": "1.1.3",
    "@huggingface/tokenizers": "^0.2.0",
    "@tiptap/extension-mention": "^3.32.0",
    "@tiptap/suggestion": "^3.32.0",
    "better-sqlite3-multiple-ciphers": "13.0.3",
    "electron-updater": "^6.8.11",
    "onnxruntime-node": "^1.31.1",
    "openai": "^7.43.0",
    "sherpa-onnx-node": "1.13.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.61.0",
    "marked": "^18.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "turndown": "^7.2.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "wrangler": "^4.152.0",
    "zustand": "^5.0.16"
  }
}
