# OAuth for "Continue with Google / Yandex" (Settings → Accounts).
# Copy to .env; values are built into the app by electron-vite. See README → "Аккаунты Google и Яндекс".

# Either: sign in through the Oats site (oats-site repo, Cloudflare Worker), which holds the
# OAuth clients and their secrets. With this set, the client settings below are not used.
# MAIN_VITE_AUTH_URL=https://oats-site.<account>.workers.dev

# Or: the app's own clients, talking to Google and Yandex directly.
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID → "Desktop app".
MAIN_VITE_GOOGLE_CLIENT_ID=
MAIN_VITE_GOOGLE_CLIENT_SECRET=

# oauth.yandex.ru → Создать приложение; Redirect URI: http://127.0.0.1:47821/oauth/callback
MAIN_VITE_YANDEX_CLIENT_ID=
# Optional (PKCE works without it); needed only to revoke tokens on Disconnect.
MAIN_VITE_YANDEX_CLIENT_SECRET=

# Loopback port for the sign-in redirect; with direct clients, change the Yandex Redirect URI with it.
# MAIN_VITE_OAUTH_PORT=47821
