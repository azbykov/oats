{
  "name": "oats",
  "productName": "Oats",
  "version": "0.1.0",
  "private": true,
  "description": "AI meeting notepad for macOS and Windows",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "postinstall": "install-electron",
    "build:native": "swift build -c release --package-path native/audio --product oats-audio && ./scripts/build-tcc.sh",
    "dist:mac": "npm run build:native && electron-vite build && electron-builder --mac --arm64 --config electron-builder.mac-arm64.yml && codesign --force --deep --sign - dist/mac-arm64/Oats.app",
    "deps:win": "npm install --no-save --force sherpa-onnx-win-x64@1.13.8 @fugood/node-whisper-win32-x64@1.1.3 @fugood/node-whisper-win32-x64-vulkan@1.1.3",
    "dist:win": "electron-vite build && electron-builder --win --config electron-builder.yml",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && wrangler dev",
    "deps:mac-x64": "npm install --no-save --force sherpa-onnx-darwin-x64@1.13.8 @fugood/node-whisper-darwin-x64@1.1.3",
    "dist:mac-x64": "./scripts/build-tcc.sh && npm run deps:mac-x64 && electron-vite build && electron-builder --mac --x64 --config electron-builder.mac-x64.yml && codesign --force --deep --sign - dist/mac/Oats.app"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@fugood/whisper.node": "1.1.3",
    "openai": "^7.43.0",
    "sherpa-onnx-node": "1.13.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.61.0",
    "marked": "^18.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "turndown": "^7.2.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.152.0",
    "zustand": "^5.0.16"
  }
}
