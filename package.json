{
  "name": "oats-monorepo",
  "private": true,
  "description": "Oats and the apps built on the same code: apps/* are the products, shared/ is the code they share",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w oats",
    "dev:rye": "npm run dev -w rye",
    "build": "npm run build -w oats",
    "build:rye": "npm run build -w rye",
    "start": "npm run start -w oats",
    "start:rye": "npm run start -w rye",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build:native": "swift build -c release --package-path native/audio --product oats-audio && ./scripts/build-tcc.sh",
    "dist:mac": "npm run build:native && npm run dist:mac -w oats",
    "dist:mac:rye": "npm run build:native && npm run dist:mac -w rye",
    "deps:win": "npm install --no-save --force sherpa-onnx-win-x64@1.13.8 @fugood/node-whisper-win32-x64@1.1.3 @fugood/node-whisper-win32-x64-vulkan@1.1.3",
    "dist:win": "node scripts/copy-vcruntime.mjs && npm run dist:win -w oats",
    "dist:win:rye": "node scripts/copy-vcruntime.mjs && npm run dist:win -w rye",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && wrangler dev",
    "deps:mac-x64": "npm install --no-save --force sherpa-onnx-darwin-x64@1.13.8 @fugood/node-whisper-darwin-x64@1.1.3",
    "dist:mac-x64": "./scripts/build-tcc.sh && npm run deps:mac-x64 && npm run dist:mac-x64 -w oats",
    "dist:mac-x64:rye": "./scripts/build-tcc.sh && npm run deps:mac-x64 && npm run dist:mac-x64 -w rye"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.1.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.61.0",
    "marked": "^18.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "turndown": "^7.2.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "wrangler": "^4.152.0",
    "zustand": "^5.0.16"
  }
}
